// This is your Prisma schema file for PostgreSQL
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TableArea {
  Indoor
  Outdoor
  VIP
}

enum TableStatus {
  available
  occupied
  reserved
  maintenance
}

enum MenuCategory {
  LAUK_UTAMA        @map("Lauk Utama")
  SAYUR_KUAH        @map("Sayur & Kuah")
  PELENGKAP_SAMBAL  @map("Pelengkap & Sambal")
  MINUMAN           @map("Minuman")
}

enum ReservationStatus {
  pending
  confirmed
  rejected
  cancelled
}

model Restaurant {
  id           String        @id @default(uuid())
  tenantId     String        @unique @map("tenant_id")
  name         String
  tagline      String?
  address      String
  city         String
  phone        String
  openingHours String        @map("opening_hours")
  openTime     String        @default("10:00") @map("open_time")
  closeTime    String        @default("22:00") @map("close_time")
  description  String?
  policies     Json?         @default("[]")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  tables       Table[]
  menuItems    MenuItem[]
  customers    Customer[]
  reservations Reservation[]
  auditEvents  AuditEvent[]

  @@map("restaurants")
}

model Table {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  tableNumber  String        @map("table_number")
  capacity     Int
  area         TableArea     @default(Indoor)
  status       TableStatus   @default(available)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  restaurant   Restaurant    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  reservations Reservation[]

  @@unique([tenantId, tableNumber])
  @@index([tenantId, capacity, area, status])
  @@map("tables")
}

model MenuItem {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  name           String
  category       MenuCategory
  price          Decimal      @db.Decimal(12, 2)
  description    String?
  isAvailable    Boolean      @default(true) @map("is_available")
  isPopular      Boolean      @default(false) @map("is_popular")
  spicinessLevel Int?         @default(1) @map("spiciness_level")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  restaurant     Restaurant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@index([tenantId, category, isAvailable])
  @@map("menu_items")
}

model Customer {
  id               String       @id @default(uuid())
  tenantId         String       @map("tenant_id")
  name             String
  phone            String
  reservationCount Int          @default(1) @map("reservation_count")
  lastVisit        DateTime?    @map("last_visit")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  restaurant       Restaurant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@unique([tenantId, phone])
  @@map("customers")
}

enum PaymentStatus {
  unpaid
  pending
  settlement
  expire
  cancel
}

model Reservation {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  code            String            @unique // e.g. RM-1001
  customerName    String            @map("customer_name")
  customerPhone   String            @map("customer_phone")
  tableId         String            @map("table_id")
  tableNumber     String            @map("table_number")
  tableArea       TableArea         @map("table_area")
  reservationDate String            @map("reservation_date") // YYYY-MM-DD
  reservationTime String            @map("reservation_time") // HH:mm
  guestCount      Int               @map("guest_count")
  status          ReservationStatus @default(pending)
  paymentStatus   PaymentStatus     @default(unpaid) @map("payment_status")
  paymentAmount   Decimal?          @db.Decimal(12, 2) @map("payment_amount")
  paymentMethod   String?           @map("payment_method")
  snapToken       String?           @map("snap_token")
  paymentPaidAt   DateTime?         @map("payment_paid_at")
  notes           String?
  rejectionReason String?           @map("rejection_reason")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  restaurant      Restaurant        @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  table           Table             @relation(fields: [tableId], references: [id])

  @@index([tenantId, reservationDate, reservationTime, status])
  @@index([tenantId, paymentStatus])
  @@map("reservations")
}

model AuditEvent {
  id         String     @id @default(uuid())
  tenantId   String     @map("tenant_id")
  actor      String
  action     String
  entity     String
  details    String?
  createdAt  DateTime   @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@map("audit_events")
}
