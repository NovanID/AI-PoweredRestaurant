  <!-- ====================================================== -->
  <!-- PAGE 4: BACKEND ANTI DOUBLE-BOOKING ATOMIC TRANSACTION -->
  <!-- ====================================================== -->
  <diagram id="page-backend-lock" name="4. Backend Anti Double-Booking">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title4" value="LOGIKA BACKEND ANTI-DOUBLE BOOKING (PRISMA TRANSACTION)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="220" y="30" width="720" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle4" value="Atomic Reservation Validation &amp; Conflict Prevention Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="220" y="65" width="720" height="20" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="tx_start" value="Request Masuk:&#xa;POST /reservations atau Tool: create_reservation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="110" width="340" height="50" as="geometry" />
        </mxCell>

        <!-- Validation -->
        <mxCell id="tx_val" value="Validasi Schema (DTO / Zod):&#xa;TenantId, Date, Time, Pax, TableId, Phone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="195" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- Begin Transaction -->
        <mxCell id="tx_begin" value="Buka Prisma Interactive Transaction&#xa;prisma.$transaction(async (tx) =&gt; { ... })" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="285" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- Query Conflict -->
        <mxCell id="tx_query" value="Query Cek Konflik Jadwal Meja:&#xa;tx.reservation.findFirst({&#xa;  where: { tenantId, tableId, reservationDate,&#xa;           reservationTime, status: { in: ['pending', 'confirmed'] } }&#xa;})" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=11;fontFamily=Courier New;align=left;" vertex="1" parent="1">
          <mxGeometry x="380" y="380" width="380" height="95" as="geometry" />
        </mxCell>

        <!-- Decision -->
        <mxCell id="tx_dec" value="Ditemukan Jadwal&#xa;Bertabrakan (Konflik)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="465" y="515" width="210" height="90" as="geometry" />
        </mxCell>

        <!-- Rollback Conflict -->
        <mxCell id="tx_rollback" value="Rollback Transaction&#xa;Throw ConflictException (HTTP 409):&#xa;'Slot Meja Sudah Dipesan'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#F43F5E;fontColor=#881337;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="530" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Insert Reservation -->
        <mxCell id="tx_insert_res" value="tx.reservation.create({&#xa;  data: { code: 'RM-XXXX', status: 'pending', ...payload }&#xa;})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;fontFamily=Courier New;align=left;" vertex="1" parent="1">
          <mxGeometry x="410" y="645" width="320" height="55" as="geometry" />
        </mxCell>

        <!-- Upsert Customer -->
        <mxCell id="tx_upsert_cust" value="tx.customer.upsert({&#xa;  where: { tenantId_phone },&#xa;  update: { reservationCount: +1, lastVisit: now() },&#xa;  create: { ...customerData }&#xa;})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=11;fontFamily=Courier New;align=left;" vertex="1" parent="1">
          <mxGeometry x="410" y="735" width="320" height="65" as="geometry" />
        </mxCell>

        <!-- Log Audit -->
        <mxCell id="tx_log_audit" value="tx.auditEvent.create({&#xa;  action: 'RESERVATION_CREATED', actor: 'customer/ai'&#xa;})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=11;fontFamily=Courier New;align=left;" vertex="1" parent="1">
          <mxGeometry x="410" y="835" width="320" height="50" as="geometry" />
        </mxCell>

        <!-- Commit -->
        <mxCell id="tx_commit" value="Commit Database Transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#065F46;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="920" width="240" height="45" as="geometry" />
        </mxCell>

        <!-- Return -->
        <mxCell id="tx_return" value="Kembalikan HTTP 201 Created&#xa;(JSON Response: Reservation &amp; Code RM-XXXX)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="1000" width="300" height="55" as="geometry" />
        </mxCell>

        <!-- End -->
        <mxCell id="tx_end" value="Selesai" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#10B981;strokeColor=#059669;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="1090" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- Connectors -->
        <mxCell id="tx_e1" edge="1" parent="1" source="tx_start" target="tx_val" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
