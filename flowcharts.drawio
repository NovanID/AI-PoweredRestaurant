        <mxCell id="adm_e_m2" edge="1" parent="1" source="adm_db_confirm" target="adm_audit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="830" y="760" />
            </Array>
