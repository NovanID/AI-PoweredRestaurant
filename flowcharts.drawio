        <mxCell id="adm_e_audit_sync" edge="1" parent="1" source="adm_audit" target="adm_sync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2;">
