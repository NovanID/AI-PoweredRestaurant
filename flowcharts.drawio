  <!-- PAGE 3: STAFF ADMIN APPROVAL FLOW          -->
  <!-- ========================================== -->
  <diagram id="page-admin-flow" name="3. Admin Staff Flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title3" value="ALUR APPROVAL &amp; PENGELOLAAN RESERVASI OLEH STAFF" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="250" y="30" width="650" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle3" value="Staff Dashboard Operations &amp; Audit Trail Lifecycle" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="250" y="65" width="650" height="20" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="adm_start" value="Mulai: Staff Login ke Admin Dashboard" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#334155;strokeColor=#1E293B;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="280" height="50" as="geometry" />
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="adm_step1" value="Buka Menu 'Reservations' &amp;&#xa;Tinjau Reservasi Berstatus 'PENDING'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="425" y="195" width="270" height="55" as="geometry" />
        </mxCell>

        <!-- Step 2: Detail check -->
        <mxCell id="adm_step2" value="Lihat Detail: Nama Customer, Nomor Meja,&#xa;Tanggal, Jam, Pax, &amp; Catatan Khusus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="415" y="285" width="290" height="55" as="geometry" />
        </mxCell>

        <!-- Decision -->
        <mxCell id="adm_dec" value="Keputusan Staff Restoran?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="455" y="380" width="210" height="90" as="geometry" />
        </mxCell>

        <!-- Branch Reject -->
        <mxCell id="adm_reject" value="Pilih: 'Tolak Reservasi'&#xa;(Input Alasan / Rejection Reason)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#F43F5E;fontColor=#881337;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="505" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="adm_db_reject" value="Update Database:&#xa;• status: 'rejected'&#xa;• rejection_reason: [keterangan]" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="170" y="605" width="240" height="75" as="geometry" />
        </mxCell>

        <!-- Branch Confirm -->
        <mxCell id="adm_confirm" value="Pilih: 'Setujui Reservasi'&#xa;(Konfirmasi Alokasi Meja)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#065F46;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="505" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="adm_db_confirm" value="Update Database:&#xa;• status: 'confirmed'&#xa;• Lock Slot Jadwal Meja" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="710" y="605" width="240" height="75" as="geometry" />
        </mxCell>

        <!-- Audit Log -->
        <mxCell id="adm_audit" value="Catat Riwayat ke Tabel AuditEvent:&#xa;(Actor: Staff Email, Action: STATUS_CHANGE, Entity: Reservation, Timestamp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="730" width="360" height="65" as="geometry" />
        </mxCell>

        <!-- Customer View Updated -->
        <mxCell id="adm_sync" value="Status Terupdate Secara Realtime:&#xa;Customer dapat melihat status baru di Web / via AI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="835" width="320" height="55" as="geometry" />
        </mxCell>

        <!-- End -->
        <mxCell id="adm_end" value="Selesai" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#10B981;strokeColor=#059669;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="930" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- Connectors -->
        <mxCell id="adm_e1" edge="1" parent="1" source="adm_start" target="adm_step1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="adm_e2" edge="1" parent="1" source="adm_step1" target="adm_step2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="adm_e3" edge="1" parent="1" source="adm_step2" target="adm_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Reject edges -->
        <mxCell id="adm_e_rej" edge="1" parent="1" source="adm_dec" target="adm_reject" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F43F5E;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_adm_rej" value="Tolak" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#F43F5E;fontStyle=1;" vertex="1" connectable="0" parent="adm_e_rej">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="adm_e_rej_db" edge="1" parent="1" source="adm_reject" target="adm_db_reject" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Confirm edges -->
        <mxCell id="adm_e_conf" edge="1" parent="1" source="adm_dec" target="adm_confirm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_adm_conf" value="Setujui" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#10B981;fontStyle=1;" vertex="1" connectable="0" parent="adm_e_conf">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="adm_e_conf_db" edge="1" parent="1" source="adm_confirm" target="adm_db_confirm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Merge to Audit -->
        <mxCell id="adm_e_m1" edge="1" parent="1" source="adm_db_reject" target="adm_audit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="290" y="760" />
