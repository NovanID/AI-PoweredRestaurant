        <mxCell id="mid_w_db_update" value="Update Database &amp; Restaurant Store:&#xa;• payment_status: 'settlement'&#xa;• reservation_status: 'confirmed'&#xa;• payment_method: 'gopay / bca_va'&#xa;• payment_paid_at: CURRENT_TIMESTAMP" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
