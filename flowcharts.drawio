  <!-- ====================================================== -->
  <!-- PAGE 5: MIDTRANS SNAP PAYMENT GATEWAY & WEBHOOK FLOW   -->
  <!-- ====================================================== -->
  <diagram id="page-midtrans-payment" name="5. Midtrans Payment Gateway">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="mid_title" value="ARSITEKTUR INTEGRASI MIDTRANS PAYMENT GATEWAY (SNAP API &amp; WEBHOOK)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="200" y="30" width="760" height="40" as="geometry" />
        </mxCell>
        <mxCell id="mid_subtitle" value="Snap Token Generation, Checkout UI Popup, &amp; SHA-512 Signature Verified Webhook Callback" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="200" y="65" width="760" height="20" as="geometry" />
        </mxCell>

        <!-- Phase 1: Snap Token Creation -->
        <mxCell id="mid_p1_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="110" width="1000" height="280" as="geometry" />
        </mxCell>
        <mxCell id="mid_p1_lbl" value="FASE 1: GENERATE SNAP TOKEN (BACKEND &amp; FRONTEND)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#4338CA;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="450" height="20" as="geometry" />
        </mxCell>

        <mxCell id="mid_c1" value="Customer Klik 'Bayar Deposit'&#xa;(Pesan Meja / Lacak Tiket)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="160" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="mid_c2" value="Client Kirim HTTP POST:&#xa;/api/payment/token&#xa;{ orderId, amount, customer }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#6366F1;fontColor=#312E81;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="360" y="155" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="mid_c3" value="Backend Call Midtrans Snap API:&#xa;POST /snap/v1/transactions&#xa;Header: Basic Auth (ServerKey)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="630" y="155" width="230" height="60" as="geometry" />
        </mxCell>

        <mxCell id="mid_c4" value="Midtrans Kembalikan:&#xa;{ token, redirect_url }" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#065F46;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="900" y="145" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="mid_c5" value="Browser Menjalankan:&#xa;window.snap.pay(token, callbacks)&#xa;(Tampil Popup QRIS, GoPay, VA, CC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="270" width="460" height="60" as="geometry" />
        </mxCell>

        <!-- Phase 2: Customer Payment & Webhook -->
        <mxCell id="mid_p2_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#10B981;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="420" width="1000" height="420" as="geometry" />
        </mxCell>
        <mxCell id="mid_p2_lbl" value="FASE 2: WEBHOOK NOTIFIKASI &amp; VERIFIKASI SIGNATURE KEAMANAN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="100" y="430" width="550" height="20" as="geometry" />
        </mxCell>

        <mxCell id="mid_w1" value="Customer Selesaikan Bayar&#xa;(Scan QRIS / Transfer VA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="475" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="mid_w2" value="Midtrans Server Kirim Webhook (HTTP POST):&#xa;/api/payment/webhook&#xa;Payload: order_id, status_code, gross_amount, signature_key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="360" y="470" width="430" height="60" as="geometry" />
        </mxCell>

        <mxCell id="mid_w_sig_dec" value="Verifikasi SHA512 Signature:&#xa;SHA512(order_id + status_code +&#xa;gross_amount + ServerKey)&#xa;=== signature_key?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="445" y="560" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="mid_w_rej" value="Tolak Webhook (HTTP 401):&#xa;'Invalid Signature Key'&#xa;(Cegah Serangan Spoofing/Tampering)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#F43F5E;fontColor=#881337;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="587.5" width="240" height="55" as="geometry" />
