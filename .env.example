# Midtrans Payment Gateway Configuration
MIDTRANS_SERVER_KEY=SB-Mid-server-your_server_key_here
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_client_key_here
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY diisi sama persis dengan MIDTRANS_CLIENT_KEY di atas (agar bisa dibaca di frontend browser)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your_client_key_here
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_restaurant?schema=public

# AI Model Configuration (9router / OpenAI-compatible)
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=sk-placeholder
AI_MODEL=qwen-plus
